# LLM
ANTHROPIC_API_KEY=your-api-key-here
PRIMARY_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Storage backend: "memory" (dev/tests; lost on restart) or "persistent"
# "persistent" requires REDIS_URL (session state + tokens) and DATABASE_URL
# (durable Role Intelligence Profiles). Set this in any deploy where a restart
# must not destroy in-progress interviews.
STORAGE_BACKEND=memory
# DATABASE_URL=postgresql://user:pass@host:5432/knowledgekeeper
# REDIS_URL=redis://default:pass@host:6379

# Session
SESSION_TTL_HOURS=72
STAGE1_TO_STAGE2_LINK_TTL_HOURS=168

# Output
DEFAULT_OUTPUT_FORMAT=docx

# API
API_SECRET_KEY=
ALLOWED_ORIGINS=https://your-app.railway.app

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Port (Railway sets this automatically)
# PORT=8321
