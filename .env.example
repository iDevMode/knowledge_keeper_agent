# LLM
ANTHROPIC_API_KEY=your-api-key-here
PRIMARY_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# ── Storage ──────────────────────────────────────────────────────────────────
# "memory"     — in-process; lost on restart. Fine for local dev and tests.
# "persistent" — Redis (session state + tokens) + Postgres (durable profiles
#                and LangGraph conversation checkpoints). Use this anywhere a
#                restart must not destroy in-progress interviews.
STORAGE_BACKEND=memory
# DATABASE_URL=postgresql://user:pass@host:5432/knowledgekeeper
# REDIS_URL=redis://default:pass@host:6379

# Session TTLs
SESSION_TTL_HOURS=72
STAGE1_TO_STAGE2_LINK_TTL_HOURS=168

# ── Document storage ─────────────────────────────────────────────────────────
# "local" — filesystem dir (single persistent container only; lost on
#           ephemeral/serverless disks).
# "s3"    — S3 / Cloudflare R2 / any S3-compatible bucket (multi-worker or
#           serverless). AWS creds come from the standard AWS_* env vars.
DOCUMENT_STORAGE=local
DOCUMENT_STORAGE_PATH=/tmp/kk_documents
# S3_BUCKET=knowledgekeeper-documents
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # for R2/MinIO
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── Email delivery ───────────────────────────────────────────────────────────
# "console" — logs the composed email (dev). "smtp" — real delivery.
EMAIL_BACKEND=console
EMAIL_FROM=KnowledgeKeeper <no-reply@knowledgekeeper.app>
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_USE_TLS=true

# Output
DEFAULT_OUTPUT_FORMAT=docx

# ── API ──────────────────────────────────────────────────────────────────────
API_SECRET_KEY=
ALLOWED_ORIGINS=https://your-app.railway.app
# Absolute base URL used in email links; falls back to the first allowed origin.
PUBLIC_BASE_URL=https://your-app.railway.app

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Port (Railway sets this automatically)
# PORT=8321
