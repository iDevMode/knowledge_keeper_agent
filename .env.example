# LLM
ANTHROPIC_API_KEY=your-api-key-here
PRIMARY_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Database — REQUIRED in production. Holds sessions, Role Intelligence Profiles and
# LangGraph checkpoints. Without it all state is in-process and every restart
# destroys in-flight interviews.
#
# Any Postgres works. Paste ONE connection string below.
#
#   Railway:  add a Postgres service and reference it —  ${{Postgres.DATABASE_URL}}
#   Supabase: Project Settings -> Database -> Connection string -> URI.
#             Choose "Session pooler", NOT "Transaction pooler". Read why below.
#             It looks like:
#               postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# ⚠ Supabase gives you three connection strings and picking the wrong one breaks
# the app *silently*:
#
#   Session pooler      port 5432 on ...pooler.supabase.com   ✅ use this
#   Direct connection   port 5432 on db.<ref>.supabase.co     ✅ works, IPv6-only
#                                                                without the IPv4 add-on
#   Transaction pooler  port 6543 on ...pooler.supabase.com   ❌ do not use
#
# Transaction mode routes consecutive statements to different backends, and
# api/postgres_store.py holds a session-scoped pg_advisory_lock across a whole
# interview turn to stop two workers driving the same LangGraph thread at once.
# Under transaction mode the lock is taken on one backend and released on
# another: no error, no log line, just checkpoint interleaving that corrupts an
# interview whenever two requests for one session arrive together. Startup
# warns if it sees port 6543, and refuses outright when WEB_CONCURRENCY > 1.
DATABASE_URL=

# Optional — the URL pytest runs the Postgres suite against. Without it 68 tests
# skip, and those 68 are the ones proving durable persistence: restart recovery,
# the store contracts, and the genuine two-worker test that would catch a broken
# advisory lock. Point it at a SCRATCH database — the suite creates and drops
# tables. Never your production one.
# TEST_DATABASE_URL=

# Session
# STAGE1_TO_STAGE2_LINK_TTL_HOURS must not exceed SESSION_TTL_HOURS: the
# employee's link cannot outlive the session behind it. Startup refuses an
# incoherent pair. To give the employee longer, raise both.
SESSION_TTL_HOURS=72
STAGE1_TO_STAGE2_LINK_TTL_HOURS=72

# Retention — see docs/data-retention.md.
# Finished handover packs are deleted automatically this many days after they
# are generated. Interview transcripts are deleted when the sessions expire.
DOCUMENT_RETENTION_DAYS=365
# Handovers that never produced a pack stay on the dashboard this long.
EXPIRED_HANDOVER_VISIBLE_DAYS=30

# Output
DEFAULT_OUTPUT_FORMAT=docx

# Email — SendGrid. Emails the finished handover pack to the recipients the
# manager gave in Stage 1. Without SENDGRID_API_KEY emails are only logged.
# EMAIL_FROM_ADDRESS must be on a domain verified in SendGrid
# (Settings → Sender Authentication).
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=handover@your-domain.co.uk
EMAIL_FROM_NAME=KnowledgeKeeper
# Public URL of the app, used for links inside emails.
PUBLIC_BASE_URL=https://your-app.railway.app

# Manager accounts (magic-link sign-in). Sign-in links are emailed, so these
# need the SendGrid settings above in production.
ACCOUNT_SESSION_DAYS=30
LOGIN_LINK_TTL_MINUTES=15

# API
# REQUIRED in production. Signs the stage-scoped session tokens that gate every
# endpoint. If unset the app falls back to a per-process key, so every restart
# invalidates every live interview link. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=
# Comma-separated. Whitespace after commas is stripped.
ALLOWED_ORIGINS=https://your-app.railway.app

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Port (Railway sets this automatically)
# PORT=8321
